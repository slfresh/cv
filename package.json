{
  "name": "cv-portfolio",
  "version": "1.0.0",
  "description": "Slavko Grbic – CV & Portfolio Website",
  "type": "module",
  "scripts": {
    "build:gallery": "node scripts/generate-gallery-data.mjs",
    "build:html": "node scripts/build.mjs",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./css/output.css --minify",
    "build": "npm run build:gallery && npm run build:html && npm run build:css",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./css/output.css --watch",
    "watch:html": "node scripts/watch-html.mjs",
    "dev": "npx -y concurrently --kill-others \"npm run watch:css\" \"npm run watch:html\" \"npx -y http-server -p 8080 -c-1\"",
    "photo-audit": "node scripts/photo-audit.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "exifr": "^7.1.3",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
